# Copy to .env for local runs. On Railway, set these as service variables instead.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is not scoped to a workspace (starts with sk-ant-usr-)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
ODDS_API_KEY=your-odds-api-key
# Any long random string. The iOS app must send the same value (Settings → App token).
APP_TOKEN=change-me-to-a-long-random-string
# Optional: where the picks cache is stored (mount a Railway volume here to keep it across deploys)
# DATA_DIR=/data
